{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.atleta-360.com"
        }
      ],
      "destination": "https://atleta-360.com/:path",
      "permanent": true
    },
    {
      "source": "/coach",
      "destination": "/mental-coach-pallavolo?utm_source=instagram&utm_medium=bio",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/opzioni?sveglia=1",
      "schedule": "0 6 * * *"
    }
  ]
}
